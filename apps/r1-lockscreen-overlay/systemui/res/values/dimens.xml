<?xml version="1.0" encoding="utf-8"?>
<!--
  Keyguard geometry for the R1. Every name and default below was read off the device with
  tools/recon-lockscreen.sh (LineageOS 21.0-20250621 arm64_bvN); see dist/recon/candidates.txt.

  Panel: 480x640 px @ density 220  ->  349dp x 465dp of usable space.
  AOSP's stock large clock is 150dp — roughly a third of the screen height on its own.

  Format is  <default>  ->  <ours>.
-->
<resources>
    <!-- Clock type. 150dp -> 76dp keeps it the focal element without burying the mascot. -->
    <dimen name="large_clock_text_size">76dp</dimen>
    <!-- 86dp -> 44dp. The "small" clock is the one shown with notifications present. -->
    <dimen name="small_clock_text_size">44dp</dimen>
    <!-- 114dp -> 58dp, tracking the smaller small-clock type above. -->
    <dimen name="small_clock_height">58dp</dimen>

    <!-- Gutters. 18dp -> 10dp lifts the clock stack toward the top edge. -->
    <dimen name="keyguard_clock_top_margin">10dp</dimen>
    <!-- 28dp -> 16dp: 28dp of leading indent is a lot of a 349dp width. -->
    <dimen name="clock_padding_start">16dp</dimen>
    <!-- "Swipe up to unlock" text. 32dp -> 16dp reclaims the bottom band. -->
    <dimen name="keyguard_indication_margin_bottom">16dp</dimen>

    <!--
      Lockscreen media player height.

      Measured on-device: the carousel renders at 184dp, i.e. this build uses the EXPANDED height
      on the lockscreen, not the collapsed one. Overriding qs_media_session_height_collapsed alone
      changed nothing (idmap confirmed the override was live, the widget did not move) — so
      _expanded_ is the lever here.

      Note this dimension is shared with the QS shade's media player, so shrinking it shortens
      that too. The collapsed pair is kept in sync so the shade's collapsed state stays coherent.
    -->
    <dimen name="qs_media_session_height_expanded">124dp</dimen>
    <dimen name="qs_media_session_height_collapsed">104dp</dimen>
    <dimen name="qs_media_session_collapsed_guideline">120dp</dimen>

    <!--
      Date/smartspace row under the clock. Defaults are asymmetric (start 32dp, end 16dp), which
      pushes centred content right by half the difference — measured as +21px on this panel once
      r1-lockscreen-tweaks centres the status area. Zeroing both makes centring land true.
    -->
    <dimen name="below_clock_padding_start">0dp</dimen>
    <dimen name="below_clock_padding_end">0dp</dimen>

    <!--
      Deliberately NOT overridden:
        status_view_margin_horizontal   default is already 0dp — setting it would ADD margin.
        keyguard_large_clock_top_margin default reads 16777156dp (a resource-reference sentinel,
                                        not a real dimension); writing a literal here would
                                        change behaviour in ways the default doesn't imply.
    -->
</resources>
