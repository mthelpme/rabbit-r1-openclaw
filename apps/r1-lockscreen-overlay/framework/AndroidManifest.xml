<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.r1lockscreen.pattern">
    <application android:hasCode="false" />
    <!--
      Targets framework-res, because LockPatternView is com.android.internal.widget.LockPatternView
      and its dot geometry/colours live in `android`, not SystemUI. Kept as a SEPARATE overlay from
      the SystemUI one so it can be disabled on its own if the framework overlay misbehaves.
    -->
    <overlay
        android:targetPackage="android"
        android:isStatic="false"
        android:priority="1" />
</manifest>
