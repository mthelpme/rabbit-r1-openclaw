<?xml version="1.0" encoding="utf-8"?>
<!--
  Intentionally empty. Replaces SystemUI's mobile data-type indicator (LTE / 5G / H+ ...) with a
  vector that draws nothing, so the label disappears while the signal bars stay.

  Why not icon_blacklist: that hides whole status-bar slots, and the only slot covering this is
  "mobile" — which would take the signal bars with it.

  All 16 originals are plain <vector> (verified with aapt2 dump xmltree against the device's own
  SystemUI.apk), so replacing them with a static vector cannot break an animated-vector cast.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="1dp"
    android:height="1dp"
    android:viewportWidth="1"
    android:viewportHeight="1" />
